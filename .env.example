DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.5-flash-lite
# GOOGLE_GENERATIVE_AI_API_KEY also enables Gemini Google Search grounding for resource discovery (no separate search API key).
# RESOURCE_DISCOVERY_ENABLED=1
# CRON_SECRET=           # Secured header for /api/cron/* (GitHub Actions + manual)
# GitHub repo variable: LEARNOS_APP_URL=https://your-app.vercel.app
# GitHub repo secret:   CRON_SECRET=<same value as Vercel env>
# RESEND_API_KEY=
# EMAIL_FROM=LearnOS <noreply@learnos.app>
# AI_GENERATION_ENABLED=1

# Inngest — set automatically by the Vercel integration; only needed for
# self-hosted deploys. Local dev uses `pnpm dev:inngest` with no keys.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# Mem0 Platform. Without it the kernel runs exactly as it did before memory.
# MEM0_API_KEY=

# MLflow tracing on Databricks. Without these, AiRun rows remain the only record.
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_ID=
