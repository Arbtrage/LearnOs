generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  ONBOARDING
  GENERATING
  ACTIVE
  ARCHIVED
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  accounts      Account[]
  sessions      Session[]
  projects      LearningProject[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LearningProject {
  id            String           @id @default(cuid())
  userId        String
  title         String
  slug          String
  category      String?
  goal          String
  status        ProjectStatus    @default(DRAFT)
  icon          String?
  accentColor   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations AIConversation[]
  blueprint     LearningBlueprint?
  sidebarItems  SidebarItem[]
  dashboardWidgets DashboardWidget[]

  @@unique([userId, slug])
  @@index([userId])
}

model AIConversation {
  id          String            @id @default(cuid())
  projectId   String
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  project     LearningProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    AIMessage[]
  answers     InterviewAnswer[]

  @@index([projectId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String         @db.Text
  metadata       Json?
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model InterviewAnswer {
  id             String         @id @default(cuid())
  conversationId String
  questionKey    String
  answer         Json
  createdAt      DateTime       @default(now())
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, questionKey])
  @@index([conversationId])
}

model LearningBlueprint {
  id              String          @id @default(cuid())
  projectId       String          @unique
  title           String
  durationWeeks   Int
  dailyCommitment String
  methodology     String
  generatedBy     String
  version         Int             @default(1)
  metadata        Json?
  createdAt       DateTime        @default(now())
  project         LearningProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stages          LearningStage[]
}

model LearningStage {
  id          String            @id @default(cuid())
  blueprintId String
  title       String
  description String            @db.Text
  order       Int
  blueprint   LearningBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
}

model SidebarItem {
  id        String          @id @default(cuid())
  projectId String
  label     String
  icon      String
  route     String
  order     Int
  visible   Boolean         @default(true)
  project   LearningProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DashboardWidget {
  id        String          @id @default(cuid())
  projectId String
  type      String
  config    Json
  order     Int
  project   LearningProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
